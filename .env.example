# Reference only: the application reads process environment variables.
# It does not automatically load this file.
EDGE_CAMERA_WEB_HOST=127.0.0.1
EDGE_CAMERA_WEB_PORT=8000
EDGE_CAMERA_WEB_PIN=
EDGE_CAMERA_WEB_COOKIE_SECURE=false
EDGE_CAMERA_DATA_DIR=data
EDGE_CAMERA_RETENTION_DAYS=30
EDGE_CAMERA_SOURCE=picamera
EDGE_CAMERA_EMBEDDER=insightface
EDGE_CAMERA_INSIGHTFACE_MODEL=buffalo_s
EDGE_CAMERA_INSIGHTFACE_ROOT=models/insightface
EDGE_CAMERA_DETECTOR=none
EDGE_CAMERA_CLIP_ENABLED=true
# SMTP and device-presence probing are disabled unless explicitly configured.
EDGE_CAMERA_SMTP_HOST=
EDGE_CAMERA_SMTP_USER=
EDGE_CAMERA_SMTP_PASSWORD=
EDGE_CAMERA_MAIL_FROM=
EDGE_CAMERA_MAIL_TO=
EDGE_CAMERA_PRESENCE_HOST=
